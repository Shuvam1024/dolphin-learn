# Dolphin local environment — placeholders only (no secrets)
# Copy to `.env` and fill in locally:  cp .env.example .env

# --- Postgres (docker-compose service `db`) ---
POSTGRES_USER=dolphin
POSTGRES_PASSWORD=dolphin
POSTGRES_DB=dolphin
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# SQLAlchemy / app connection string (matches Compose defaults)
DATABASE_URL=postgresql+psycopg://dolphin:dolphin@localhost:5432/dolphin

# --- API (FastAPI — services/api) ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development
LOG_LEVEL=info

# --- Web (Next.js — apps/web) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
WEB_PORT=3000

# --- Managed auth (OIDC) ---
# Local development verifies HS256 tokens from the dev issuer below.
# That secret is not a password store. Production sets ENVIRONMENT=production,
# a real AUTH_ISSUER_URL / AUTH_AUDIENCE, and AUTH_JWKS_URL (RS256). Never commit real secrets.
AUTH_PROVIDER=dev
AUTH_ISSUER_URL=https://dolphin.local/dev
AUTH_AUDIENCE=dolphin-api
AUTH_JWKS_URL=
AUTH_DEV_SECRET=dev-only-not-a-password
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
# Public web client id if distinct from API
NEXT_PUBLIC_AUTH_CLIENT_ID=
NEXT_PUBLIC_AUTH_DOMAIN=

# --- AI / LLM (OPTIONAL) ---
# Prove Loop seeded content must work with these unset.
# Leave blank for local Phase 0 / 1A demos.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_GATEWAY_ENABLED=false
AI_DEFAULT_MODEL=

# --- Object storage / Vault (NOT Phase 0–1A) ---
# Placeholders reserved so later steps do not invent ad-hoc names.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Observability (optional) ---
SENTRY_DSN=
